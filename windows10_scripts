@echo off
REM --- 1. FORCE NETWORK TO PRIVATE ---
powershell.exe -ExecutionPolicy Bypass -Command "Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private"

REM --- 2. CONFIGURE WinRM SERVICE & AUTH ---
powershell.exe -ExecutionPolicy Bypass -Command "winrm quickconfig -q; winrm set winrm/config/service/auth '@{Basic=\"true\"}'; winrm set winrm/config/service '@{AllowUnencrypted=\"true\"}'; Set-Service WinRM -StartupType Automatic"

REM --- 3. FORCE FIREWALL RULES (EXPLICIT) ---
netsh advfirewall firewall add rule name="Ansible-WinRM-HTTP" dir=in action=allow protocol=TCP localport=5985
netsh advfirewall firewall add rule name="Ansible-WinRM-HTTPS" dir=in action=allow protocol=TCP localport=5986
netsh advfirewall firewall add rule name="Ansible-RDP" dir=in action=allow protocol=TCP localport=3389

REM --- 4. RDP REGISTRY FIXES ---
reg add "HKLM\System\CurrentControlSet\Control\Terminal Server" /v fDenyTSConnections /t REG_DWORD /d 0 /f
reg add "HKLM\System\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp" /v UserAuthentication /t REG_DWORD /d 0 /f

REM --- 5. ENABLE RDP GROUPS AS BACKUP ---
netsh advfirewall firewall set rule group="remote desktop" new enable=Yes








C:\Windows\System32\Sysprep\sysprep.exe /oobe /generalize /shutdown /unattend:C:\Windows\Panther\Unattend.xml














######Make everything automatically

# 1. ENSURE DIRECTORIES EXIST
New-Item -Path "C:\Windows\Setup\Scripts" -ItemType Directory -Force | Out-Null

# 2. CONFIGURE RDP (Matches your Ansible tasks)
# Enable RDP
Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -Name "fDenyTSConnections" -Value 0
# Disable NLA for easier access
Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp' -Name "UserAuthentication" -Value 0
# Open Firewall for RDP
Enable-NetFirewallRule -DisplayGroup "Remote Desktop"

# 3. CONFIGURE WinRM (For Ansible Connectivity)
winrm quickconfig -q
winrm set winrm/config/service/auth '@{Basic="true"}'
winrm set winrm/config/service '@{AllowUnencrypted="true"}'
Set-Service WinRM -StartupType Automatic

# 4. FIX NETWORK & STORAGE (Prevents Sysprep Errors)
Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private
Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\ReserveManager" -Name "ShippedWithReserves" -Value 0

